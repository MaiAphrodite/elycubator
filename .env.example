# Runtime
APP_ENV=production
PORT=3000
DB_PATH=/data/elycubator.db
REGISTRATION_ENABLED=true
TELEMETRY_RETENTION_DAYS=30
# Extra origins allowed to call the API cross-origin, comma separated.
# Leave empty in production: the SPA is served by the same container.
CORS_ORIGINS=

# Auth, generate with: openssl rand -hex 64
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-64
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=168h
DEVICE_TOKEN_EXPIRES_IN=720h

# Device shared secret, preflash onto ESP32 firmware.
# Production follow-up: per-device secrets provisioned at factory time.
DEVICE_SECRET=change-me-per-device-in-production

# Token required by the legacy /api.php firmware compatibility endpoint.
# Generate with: openssl rand -hex 32
LEGACY_API_TOKEN=change-me-legacy-device-token
