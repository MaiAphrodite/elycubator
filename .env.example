# Database
DB_PASSWORD=local_postgres_password_here

# Cloudflare (Only needed on VPS)
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here

# Auth — generate with: openssl rand -hex 64
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-64
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
DEVICE_TOKEN_EXPIRES_IN=30d

# Device shared secret — pre-flash onto ESP32 firmware
# In production each device gets a unique secret burned at factory time
DEVICE_SECRET=change-me-per-device-in-production
